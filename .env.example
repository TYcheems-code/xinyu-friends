# API 密钥配置

# ==========================================
# 硅基流动 SiliconFlow API（推荐 - 国内可直接访问）
# ==========================================
# 注册地址: https://siliconflow.cn
# 免费额度: 有免费试用

# 本地开发
SILICONFLOW_API_KEY=your_siliconflow_api_key_here

# Vercel 部署 (在 Dashboard > Settings > Environment Variables 中添加)
# VITE_SILICONFLOW_API_KEY=your_siliconflow_api_key_here

# ==========================================
# OpenRouter API（备用 - 需要科学上网）
# ==========================================
# 注册地址: https://openrouter.ai

# 本地开发
OPENROUTER_API_KEY=your_openrouter_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Vercel 部署
# VITE_OPENROUTER_API_KEY=your_openrouter_api_key_here
# VITE_GEMINI_API_KEY=your_gemini_api_key_here

# ==========================================
# Supabase 配置（可选 - 用于用户数据持久化）
# ==========================================
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Vercel 部署
# VITE_SUPABASE_URL=https://your-project-id.supabase.co
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
